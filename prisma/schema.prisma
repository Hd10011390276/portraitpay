// ============================================================
// PortraitPay AI — Schema (No Enums for Neon Free Tier)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User
// ============================================================

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String?
  phone        String? @unique

  // Role: USER, ARTIST, AGENCY, ENTERPRISE, CELEBRITY, ADMIN, VERIFIER
  role           String    @default("USER")
  // KYC Status: NOT_STARTED, PENDING, APPROVED, REJECTED, EXPIRED
  kycStatus      String    @default("NOT_STARTED")
  kycProviderRef String?
  kycVerifiedAt  DateTime?
  kycExpiredAt   DateTime?
  kycLevel       Int?

  walletAddress    String? @unique()
  stripeCustomerId String?

  displayName String?
  bio         String?

  // Actor Media Kit — external URL for headshots, demo reel, casting profile
  mediaKitUrl                    String?
  mediaKitShareConfirmed         Boolean @default(false)
  mediaKitReviewOnlyAcknowledged Boolean @default(false)
  // Visibility: PUBLIC, VERIFIED_CREATORS, PRIVATE
  mediaKitVisibility             String  @default("PRIVATE")

  // OTP fields
  otpCode    String?
  otpExpires DateTime?

  // Password reset fields
  resetToken   String?
  resetExpires DateTime?

  // Email verification fields
  verificationCode    String?
  verificationExpires DateTime?
  emailVerified       Boolean   @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  portraits             Portrait[]
  authorizations        Authorization[]        @relation("AuthGranter")
  granteeAuthorizations Authorization[]        @relation("AuthGrantee")
  licenses              License[]
  transactions          Transaction[]
  infringementReports   InfringementReport[]   @relation("ReportDefendant")
  reportsAsVictim       InfringementReport[] @relation("ReportVictim")
  quickReports         InfringementReportQuick[]
  kycLogs               KYCLog[]
  celebrityApplications CelebrityApplication[]

  withdrawals Withdrawal[]
  settlements Settlement[]
  auditLogs   AuditLog[]   @relation("AuditAdmin")

  monitorConfig InfringementMonitorConfig?

  lawyerRegistrations        LawyerRegistration[]
  messages                   Message[]
  conversationParticipations ConversationParticipant[]

  accounts        Account[]
  sessions        Session[]
  name            String?
  image           String?
  notifications   Notification[]
  userAuditLogs   UserAuditLog[]
  apiKeys         ApiKey[]
  aicontents      AIContent[]
  ipregistrations IPRegistration[]

  portraitSettings     PortraitSettings?
  digitalHumanLicenses DigitalHumanLicense[]

  licensePackages  LicensePackage[]
  marketplaceRequests  MarketplaceRequest[]  @relation("Requester")
  marketplaceRequestsTarget MarketplaceRequest[] @relation("RequestTarget")
  offersFrom        Offer[] @relation("OfferFromUser")
  offersTo         Offer[] @relation("OfferToUser")
  dealsAsPayer     Deal[] @relation("DealPayer")
  dealsAsPayee     Deal[] @relation("DealPayee")
  balanceTransactions BalanceTransaction[]

  voiceEmbeddings VoiceEmbedding[]

  @@index([walletAddress])
  @@index([kycStatus])
}

// ============================================================
// PortraitSettings - User portrait usage preferences
// ============================================================

model PortraitSettings {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Default usage preference: true = allow licensing, false = all rights reserved
  allowLicensing Boolean @default(true)

  // Allowed usage scopes (empty = no restrictions, all allowed)
  // Values: FILM, ANIMATION, ADVERTISING, GAMING, PRINT, MERCHANDISE, SOCIAL_MEDIA, EDUCATION, NEWS
  allowedScopes String[] @default([])

  // Prohibited content types (content NEVER allowed regardless of licensing)
  // Values: ADULT, POLITICAL, VIOLENCE, HATE, FRAUD, WEAPONS, ILLEGAL
  prohibitedContent String[] @default([])

  // Default license fee in USD (0 = user decides case by case)
  defaultLicenseFee Decimal @default(0) @db.Decimal(12, 2)

  // Default territorial scope: global, china, asia, europe, americas
  defaultTerritorialScope String @default("global")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Portrait
// ============================================================

model Portrait {
  id String @id @default(cuid())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  title       String
  description String?
  category    String  @default("general")

  // Actor classification
  gender         String? // male, female, non_binary, not_specified
  roleType       String? // actor, model, influencer, celebrity, voice_actor, stunt_performer
  productionType String? // live_action, animation, vfx, cgi, mixed_media
  tags           String[] @default([])

  originalImageUrl String?
  thumbnailUrl     String?
  imageHash        String?

  blockchainTxHash  String?   @unique
  blockchainNetwork String?   @default("sepolia")
  certifiedAt       DateTime?
  // Sequential certificate number: CERT-2026-00001
  certificateNumber Int?      @unique

  // Status: DRAFT, ACTIVE, SUSPENDED, ARCHIVED
  status String @default("DRAFT")

  // SHA-256 hashes of uploaded photos (computed server-side at upload time)
  portraitImageHash String?
  idCardFrontHash   String?

  // Three-view photos for celebrity/actor portraits (正面/侧面/后面)
  frontViewUrl  String? // 正面照
  sideViewUrl   String? // 侧面照
  backViewUrl   String? // 后面照
  threeViewHash String? // Combined hash of all three views

  // Google Drive links for three-view reference materials (用户上传到 Google Drive 的三视图资料链接)
  threeViewFront String? // 正视图 Google Drive 链接
  threeViewSide  String? // 侧视图 Google Drive 链接
  threeViewTop   String? // 仰视图 Google Drive 链接

  // ID card info — captured at mint time
  idCardType   String? // driver_license | us_id | passport | other
  idCardName   String? // real name as shown on ID card
  idCardNumber String? // ID card number (stored encrypted/masked in responses)

  isPublic Boolean @default(false)

  // AI Licensing settings (per-portrait override)
  // null means use PortraitSettings default; true = allow AI licensing, false = block
  allowAiLicensing   Boolean?
  aiLicenseFee       Decimal? @db.Decimal(12, 2) // Override fee (null = use default)
  aiLicenseScopes    String[] @default([]) // Empty = all scopes allowed
  aiProhibitedScopes String[] @default([]) // Blocked scopes for this portrait
  aiTerritorialScope String   @default("global") // Override territorial scope

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  authorizations       Authorization[]
  conversations        Conversation[]
  licenses             License[]
  reports              InfringementReport[]
  entAuthApplications  EntAuthApplication[]
  digitalHumanLicenses DigitalHumanLicense[]
  licensePackages      LicensePackage[]
  marketplaceRequests  MarketplaceRequest[]

  @@index([ownerId])
  @@index([status])
}

// ============================================================
// Authorization
// ============================================================

model Authorization {
  id String @id @default(cuid())

  portraitId String
  portrait   Portrait @relation(fields: [portraitId], references: [id])

  granterId String
  granteeId String
  grantee   User   @relation("AuthGrantee", fields: [granteeId], references: [id])
  granter   User   @relation("AuthGranter", fields: [granterId], references: [id])

  // License Type: EXCLUSIVE, NON_EXCLUSIVE, SEMI_EXCLUSIVE, EDITORIAL, PERSONAL
  licenseType      String
  usageScope       String[] @default([])
  exclusivity      Boolean  @default(false)
  territorialScope String   @default("global")

  startDate DateTime
  endDate   DateTime?

  licenseFee Decimal @db.Decimal(12, 2)
  currency   String  @default("USD")

  platformFee  Decimal? @db.Decimal(12, 2)
  actorPayment Decimal? @db.Decimal(12, 2)

  terms String @db.Text

  contractHash    String? @unique
  contractIpfsCid String?

  // Status: PENDING, ACTIVE, EXPIRED, REVOKED, REJECTED
  status String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  licenses           License[]
  transaction        Transaction?
  entAuthApplication EntAuthApplication?
  conversations      Conversation[]
  deals             Deal[]

  @@index([portraitId])
  @@index([granteeId])
  @@index([status])
}

// ============================================================
// Consent Passport
// ============================================================

model ConsentPassport {
  id String @id @default(cuid())

  // Public token for sharing (no auth needed to view)
  shareToken String @unique @default(cuid())

  // Basic info
  fullName String
  email    String

  // Allowed uses - e.g. VIDEO_GENERATION, VOICE_CLONE, DIGITAL_AVATAR, ADVERTISING
  allowedUses    String[] @default([])
  prohibitedUses String[] @default([])

  // Optional
  contactInfo     String?
  additionalTerms String?

  // Three-view Google Drive links
  threeViewFront String?
  threeViewSide  String?
  threeViewTop   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// Transaction
// ============================================================

model Transaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Type: LICENSE_PURCHASE, LICENSE_RENEWAL, ROYALTY_PAYOUT, KYC_REFUND, PLATFORM_FEE, WITHDRAWAL, SETTLEMENT, PLATFORM_COMMISSION
  type   String
  // Status: PENDING, COMPLETED, FAILED, REFUNDED, DISPUTED
  status String @default("PENDING")

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  authorizationId String?        @unique
  authorization   Authorization? @relation(fields: [authorizationId], references: [id])

  stripePaymentIntentId String? @unique
  stripeInvoiceId       String?

  royaltyRecipient String?
  royaltyPaid      Boolean @default(false)
  royaltyTxHash    String?

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([stripePaymentIntentId])
}

// ============================================================
// InfringementReport
// ============================================================

model InfringementReport {
  id String @id @default(cuid())

  reporterId String
  reporter   User   @relation("ReportVictim", fields: [reporterId], references: [id])

  defendantId String?
  defendant   User?   @relation("ReportDefendant", fields: [defendantId], references: [id])

  portraitId String
  portrait   Portrait @relation(fields: [portraitId], references: [id])

  // Type: UNAUTHORIZED_USE, EXPIRED_LICENSE, SCOPE_VIOLATION, RESALE, DEEPFAKE
  type String

  evidenceUrls     String[] @default([])
  evidenceHash     String?
  originalImageUrl String?

  description String    @db.Text
  detectedUrl String?
  detectedAt  DateTime?

  // Status: PENDING_REVIEW, VALIDATED, REJECTED, SETTLED, LEGAL_ACTION
  status String @default("PENDING_REVIEW")

  verifierId String?
  verifiedAt DateTime?
  resolution String?   @db.Text

  reportHash    String? @unique
  reportIpfsCid String?

  // Source: MANUAL, AUTO
  source String @default("MANUAL")

  similarityScore Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alertId String? @unique

  notices       InfringementNotice[]
  lawyerCases   LawyerCase[]
  conversations Conversation[]

  @@index([portraitId])
  @@index([reporterId])
  @@index([status])
  @@index([source])
}

// ============================================================
// PublicReport — anonymous public infringement submission
// ============================================================

model PublicReport {
  id String @id @default(cuid())

  // Contact info (optional for anonymous reporter)
  reporterEmail String?
  reporterName  String?

  // Target portrait (can be empty if user doesn't know the ID)
  portraitId    String?
  portraitTitle String?

  // Infringement details
  type             String // UNAUTHORIZED_USE, EXPIRED_LICENSE, SCOPE_VIOLATION, RESALE, DEEPFAKE
  description      String   @db.Text
  detectedUrl      String?
  evidenceUrls     String[] @default([])
  originalImageUrl String?

  // Status: PENDING_REVIEW, VALIDATED, REJECTED, CONVERTED
  status String @default("PENDING_REVIEW")

  // If converted to a formal InfringementReport
  convertedToId String? @unique

  // Extensibility: stored raw metadata + webhook delivery record
  metadata   Json? // free-form: { source, userAgent, landingPage, ... }
  webhookLog Json? // { attemptedAt, status, response, retries }

  // Hash for deduplication
  reportHash String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portraitId])
  @@index([status])
  @@index([createdAt])
}

// ============================================================
// InfringementAlert
// ============================================================

model InfringementAlert {
  id String @id @default(cuid())

  portraitId String

  sourceUrl  String
  sourceName String
  sourceType String

  similarityScore  Float
  matchedEmbedding Float[]

  screenshotUrl  String?
  screenshotHash String?

  pageTitle       String?
  pageDescription String?
  authorName      String?
  publishedAt     DateTime?

  // Status: PENDING, CONFIRMED, FALSE_POSITIVE, EXPIRED
  status String @default("PENDING")

  ownerId          String?
  ownerConfirmedAt DateTime?
  ownerDecision    String?

  reportId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portraitId])
  @@index([status])
  @@index([sourceName])
}

// ============================================================
// InfringementMonitorConfig
// ============================================================

model InfringementMonitorConfig {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  enabled Boolean @default(true)

  similarityThreshold Float @default(0.85)

  enabledPlatforms  String[] @default([])
  excludedPlatforms String[] @default([])

  notifyEmail  Boolean @default(true)
  notifySms    Boolean @default(false)
  notifyWechat Boolean @default(false)

  quietHoursStart String?
  quietHoursEnd   String?

  highPriorityMuteExempt Boolean @default(true)

  scanIntervalHours Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// InfringementNotice
// ============================================================

model InfringementNotice {
  id String @id @default(cuid())

  reportId String
  report   InfringementReport @relation(fields: [reportId], references: [id])

  // Type: TAKEDOWN, WARNING, LEGAL
  type String @default("TAKEDOWN")

  recipientName    String
  recipientEmail   String?
  recipientPhone   String?
  recipientAddress String? @db.Text

  subject      String
  body         String  @db.Text
  renderedHtml String? @db.Text

  attachmentUrl String?

  // Channel: EMAIL, POST, API
  channel String @default("EMAIL")

  // Status: DRAFT, SENT, RECEIVED, ACKNOWLEDGED, COMPLIED, REJECTED, ESCALATED
  status String @default("DRAFT")

  sentAt DateTime?

  notarizationId   String?
  notarizationCert String?
  notarizedAt      DateTime?

  noticeHash    String? @unique
  noticeIpfsCid String?

  responseReceivedAt DateTime?
  responseContent    String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reportId])
  @@index([status])
}

// ============================================================
// EvidencePackage
// ============================================================

model EvidencePackage {
  id String @id @default(cuid())

  reportId String? @unique
  alertId  String? @unique

  evidenceType String
  evidenceUrl  String
  evidenceKey  String?

  capturedAt DateTime @default(now())
  capturedBy String   @default("SYSTEM")

  contentHash String @unique

  pageUrl         String?
  pageTitle       String?
  pageSnapshotUrl String?

  ipfsCid String?

  notarized      Boolean @default(false)
  notarizationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// KYCLog
// ============================================================

model KYCLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  provider    String
  externalRef String?
  action      String
  result      Json?

  level          Int?
  idCardNumber   String?
  idCardName     String?
  idCardAddress  String?
  idCardExpire   DateTime?
  faceMatchScore Float?
  ocrRawData     Json?
  faceRawData    Json?
  rejectReason   String?
  verifierId     String?

  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// CelebrityApplication
// ============================================================

model CelebrityApplication {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  stageName      String
  realName       String
  idCardNumber   String
  idCardFrontUrl String
  idCardBackUrl  String
  authLetterUrl  String
  authLetterHash String?
  notaryCertUrl  String?

  agencyName    String?
  agencyContact String?
  agencyPhone   String?

  // Status: PENDING_REVIEW, APPROVED, REJECTED
  status String @default("PENDING_REVIEW")

  reviewerId      String?
  reviewedAt      DateTime?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================================
// License
// ============================================================

model License {
  id String @id @default(cuid())

  authorizationId String
  authorization   Authorization @relation(fields: [authorizationId], references: [id])

  portraitId String
  portrait   Portrait @relation(fields: [portraitId], references: [id])

  licenseeId String
  user       User   @relation(fields: [licenseeId], references: [id])

  startDate DateTime
  endDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([portraitId])
  @@index([licenseeId])
}

// ============================================================
// Enterprise
// ============================================================

model Enterprise {
  id String @id @default(cuid())

  userId String @unique

  companyName       String
  unifiedCreditCode String    @unique
  legalPersonName   String
  legalPersonIdCard String
  registeredCapital String?
  establishedDate   DateTime?
  businessTerm      String?
  businessScope     String?   @db.Text

  licenseImageUrl           String
  legalPersonIdCardFrontUrl String?
  legalPersonIdCardBackUrl  String?

  contactName  String
  contactPhone String
  contactEmail String

  // Status: PENDING, APPROVED, REJECTED, EXPIRED
  status          String    @default("PENDING")
  reviewerId      String?
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  isAgency         Boolean @default(false)
  agencyLicenseUrl String?

  validUntil DateTime?

  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  entAuthApplications EntAuthApplication[]

  @@index([userId])
  @@index([status])
}

// ============================================================
// AgencyArtist
// ============================================================

model AgencyArtist {
  id String @id @default(cuid())

  agencyId String
  artistId String

  proxyAgreementUrl String?
  proxyStartDate    DateTime?
  proxyEndDate      DateTime?
  // Status: ACTIVE, EXPIRED, REVOKED
  proxyStatus       String    @default("ACTIVE")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, artistId])
  @@index([agencyId])
  @@index([artistId])
}

// ============================================================
// EntAuthApplication
// ============================================================

model EntAuthApplication {
  id String @id @default(cuid())

  enterpriseId String
  enterprise   Enterprise @relation(fields: [enterpriseId], references: [id])

  portraitId String
  portrait   Portrait @relation(fields: [portraitId], references: [id])

  purpose          String   @db.Text
  usageScope       String[] @default([])
  exclusivity      Boolean  @default(false)
  territorialScope String   @default("global")
  usageDuration    Int

  proposedFee Decimal @db.Decimal(12, 2)
  currency    String  @default("CNY")

  // Status: PENDING_PORTRAIT_OWNER, PENDING_PLATFORM_REVIEW, APPROVED, REJECTED, REVOKED, EXPIRED
  status String @default("PENDING_PORTRAIT_OWNER")

  portraitOwnerConfirmedAt DateTime?
  portraitOwnerConfirmed   Boolean   @default(false)

  platformReviewerId      String?
  platformReviewedAt      DateTime?
  platformRejectionReason String?   @db.Text

  authorizationId String?        @unique
  authorization   Authorization? @relation(fields: [authorizationId], references: [id])

  contractHash    String? @unique
  contractIpfsCid String?

  certificateNo String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([enterpriseId])
  @@index([portraitId])
  @@index([status])
}

// ============================================================
// AuthorizationCertificate
// ============================================================

model AuthorizationCertificate {
  id String @id @default(cuid())

  applicationId   String @unique
  authorizationId String @unique

  certificateNo String    @unique
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime?

  pdfUrl String?

  blockchainTxHash  String?
  blockchainNetwork String?

  portraitOwnerSigned Boolean @default(false)
  enterpriseSigned    Boolean @default(false)
  platformSigned      Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([certificateNo])
}

// ============================================================
// Withdrawal
// ============================================================

model Withdrawal {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @default("CNY")
  actualAmount Decimal? @db.Decimal(12, 2)
  exchangeRate Decimal? @db.Decimal(12, 4)

  bankName         String?
  bankAccount      String?
  bankAccountLast4 String?
  accountHolder    String?

  // Withdrawal region: CN (China), US (United States), HK (Hong Kong), TW (Taiwan), OTHER
  region String @default("CN")

  // Status: PENDING, PROCESSING, APPROVED, REJECTED, COMPLETED, FAILED
  status          String    @default("PENDING")
  rejectionReason String?
  approvedAt      DateTime?
  approvedBy      String?
  processedAt     DateTime?
  completedAt     DateTime?

  stripeTransferId String?
  stripePayoutId   String?

  settlementId String?
  settlement   Settlement? @relation(fields: [settlementId], references: [id])

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([settlementId])
}

// ============================================================
// Settlement
// ============================================================

model Settlement {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  periodStart DateTime
  periodEnd   DateTime

  grossRevenue Decimal @db.Decimal(12, 2)
  platformFee  Decimal @db.Decimal(12, 2)
  netRevenue   Decimal @db.Decimal(12, 2)

  withdrawnAmount Decimal @default(0) @db.Decimal(12, 2)
  pendingAmount   Decimal @default(0) @db.Decimal(12, 2)
  availableAmount Decimal @default(0) @db.Decimal(12, 2)

  currency String @default("CNY")
  // Status: PENDING, CALCULATING, COMPLETED, CANCELLED
  status   String @default("PENDING")

  breakdown Json?

  settledAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  withdrawals Withdrawal[]

  @@index([userId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// ============================================================
// AuditLog
// ============================================================

model AuditLog {
  id String @id @default(cuid())

  adminId    String
  admin      User    @relation("AuditAdmin", fields: [adminId], references: [id])
  targetType String
  targetId   String
  // Action: WITHDRAWAL_APPROVE, WITHDRAWAL_REJECT, SETTLEMENT_GENERATE, SETTLEMENT_APPROVE, USER_BALANCE_ADJUST, TRANSACTION_FLAG
  action     String
  before     Json?
  after      Json?
  reason     String?

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetType, targetId])
}

// ============================================================
// Notification
// ============================================================

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Type: SYSTEM, AUTHORIZATION, EARNING, INFRINGEMENT, KYC, SETTLEMENT, WITHDRAWAL
  type  String @default("SYSTEM")
  title String
  body  String @db.Text
  data  Json?

  isRead Boolean   @default(false)
  readAt DateTime?

  // Channel: IN_APP, WEBSOCKET, EMAIL, SMS
  channel String @default("IN_APP")

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

// ============================================================
// UserAuditLog
// ============================================================

model UserAuditLog {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Action: LOGIN, LOGIN_FAILED, LOGOUT, OTP_SENT, OTP_VERIFIED, OTP_FAILED, PROFILE_UPDATE, PHONE_BIND, PHONE_UNBIND, WALLET_BIND, WALLET_UNBIND, KYC_SUBMITTED, KYC_APPROVED, KYC_REJECTED, KYC_EXPIRED, PORTRAIT_REGISTERED, PORTRAIT_UPDATED, PORTRAIT_SUSPENDED, PORTRAIT_DELETED, AUTH_REQUEST_SENT, AUTH_APPROVED, AUTH_REJECTED, AUTH_REVOKED, AUTH_CERTIFICATE_DOWNLOADED, EARNINGS_WITHDRAWN, EARNINGS_EXPORTED, SETTLEMENT_VIEWED, NOTIFICATION_SETTINGS_UPDATED, MONITOR_CONFIG_UPDATED, API_KEY_CREATED, API_KEY_DELETED, API_KEY_ROTATED
  action    String
  ipAddress String?
  userAgent String?

  targetType String?
  targetId   String?

  success Boolean @default(true)
  detail  String? @db.Text
  meta    Json?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, action])
  @@index([action, createdAt])
}

// ============================================================
