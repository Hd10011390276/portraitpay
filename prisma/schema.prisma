// ============================================================
// LawyerRegistration — Lawyer/Firm Onboarding
// ============================================================

model LawyerRegistration {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  companyName  String
  region       String // e.g. "北京市", "上海市", "广东省"
  lawyerType   String @default("firm") // "firm" = 律师楼, "personal" = 个人律师
  contactName  String
  contactEmail String
  contactPhone String

  // URL to business license or bar association certificate
  licenseUrl String?

  // Status: PENDING, REVIEWING, APPROVED, REJECTED
  status String @default("PENDING")

  reviewerId      String?
  reviewedAt      DateTime?
  rejectionReason String?   @db.Text

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  lawyerCases LawyerCase[]

  @@index([status])
  @@index([region])
  @@index([createdAt])
}

// ============================================================
// LawyerCase — Attorney case assignment and fee settlement
// ============================================================

model LawyerCase {
  id String @id @default(cuid())

  // One case per infringement report (unique constraint)
  infringementReportId String             @unique
  infringementReport   InfringementReport @relation(fields: [infringementReportId], references: [id])

  lawyerRegistrationId String
  lawyerRegistration   LawyerRegistration @relation(fields: [lawyerRegistrationId], references: [id])

  // 状态机
  // PENDING = 律师已接案，等待平台确认
  // IN_PROGRESS = 平台确认，案件激活
  // WON = 胜诉（赔偿金到位）
  // LOST = 败诉
  // CLOSED = 案件结算完毕
  // REJECTED = 平台拒绝此案件
  status String @default("PENDING")

  // 平台管理员必须确认才能激活案件（防假案件）
  platformConfirmed Boolean @default(false)

  // 赔偿金分配
  compensation        Decimal @db.Decimal(12, 2) // 侵权方赔付总金额
  platformFee         Decimal @db.Decimal(12, 2) // platformFeeRate × compensation
  lawyerFee           Decimal @db.Decimal(12, 2) // (compensation - platformFee) × lawyerFeeRate
  portraitOwnerPayout Decimal @db.Decimal(12, 2) // compensation - platformFee - lawyerFee

  // 案件描述/备注
  description String? @db.Text

  // 费率
  lawyerFeeRate   Decimal @default(0.20) @db.Decimal(5, 4) // 20%
  platformFeeRate Decimal @default(0.10) @db.Decimal(5, 4) // 10%

  // 结算信息
  closedAt        DateTime?
  resolutionNotes String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages      Message[]
  conversations Conversation[]
  deals        Deal[]

  @@index([lawyerRegistrationId])
  @@index([status])
}

// ============================================================
// Conversation — Marketplace messaging context
// ============================================================

model Conversation {
  id String @id @default(cuid())

  // Type: LICENSING | INFRINGEMENT | GENERAL | LAWYER_CASE
  type String @default("GENERAL")

  subject String?

  // Context links (all nullable — any combination may be set)
  portraitId           String?
  authorizationId      String?
  infringementReportId String?
  lawyerCaseId         String?

  // Status: OPEN | CLOSED | ARCHIVED
  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  portrait           Portrait?           @relation(fields: [portraitId], references: [id])
  authorization      Authorization?      @relation(fields: [authorizationId], references: [id])
  infringementReport InfringementReport? @relation(fields: [infringementReportId], references: [id])
  lawyerCase         LawyerCase?         @relation(fields: [lawyerCaseId], references: [id])
  offers             Offer[]
  marketplaceRequests MarketplaceRequest[]

  @@index([status])
  @@index([portraitId])
  @@index([authorizationId])
  @@index([infringementReportId])
  @@index([lawyerCaseId])
  @@index([createdAt])
}

// ============================================================
// LicensePackage — Actor-defined sellable license packages
// ============================================================

model LicensePackage {
  id String @id @default(cuid())

  portraitId String
  portrait   Portrait @relation(fields: [portraitId], references: [id])

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  title       String
  description String?
  usageScope  String[]
  prohibitedUses String[]
  territory   String @default("global")
  durationDays Int @default(365)
  price        Decimal @db.Decimal(12, 2)
  currency     String @default("USD")
  isActive     Boolean @default(true)
  requiresApproval Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers Offer[]

  @@index([portraitId])
  @@index([ownerId])
  @@index([isActive])
}

// ============================================================
// MarketplaceRequest — Structured buyer request
// ============================================================

model MarketplaceRequest {
  id String @id @default(cuid())

  // Type: LICENSING | CREATOR_PROJECT | LEGAL_HELP | INFRINGEMENT
  type String @default("LICENSING")

  requesterId String
  requester   User   @relation("Requester", fields: [requesterId], references: [id])
  targetUserId String?
  targetUser  User?  @relation("RequestTarget", fields: [targetUserId], references: [id])
  portraitId  String?
  portrait    Portrait? @relation(fields: [portraitId], references: [id])
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  title       String
  description String?
  budget      Decimal? @db.Decimal(12, 2)
  currency    String @default("USD")
  usageScope  String[]
  territory   String @default("global")
  deadline    DateTime?

  // Status: OPEN | OFFERED | ACCEPTED | CLOSED | CANCELLED
  status String @default("OPEN")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offers Offer[]

  @@index([requesterId])
  @@index([status])
  @@index([portraitId])
  @@index([type])
}

// ============================================================
// Offer — Money from conversation/request
// ============================================================

model Offer {
  id String @id @default(cuid())

  requestId       String?
  request         MarketplaceRequest? @relation(fields: [requestId], references: [id])
  conversationId  String?
  conversation   Conversation?        @relation(fields: [conversationId], references: [id])
  licensePackageId String?
  licensePackage  LicensePackage? @relation(fields: [licensePackageId], references: [id])

  fromUserId String
  fromUser   User   @relation("OfferFromUser", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User   @relation("OfferToUser", fields: [toUserId], references: [id])

  // Type: LICENSE | LEGAL_SERVICE | CREATOR_SERVICE
  type    String
  title   String
  terms   String   @db.Text
  amount  Decimal  @db.Decimal(12, 2)
  currency String @default("USD")
  platformFee Decimal @db.Decimal(12, 2)
  netPayout Decimal @db.Decimal(12, 2)

  // Status: SENT | ACCEPTED | REJECTED | EXPIRED | PAID | CANCELLED
  status   String @default("SENT")
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal Deal?

  @@index([fromUserId])
  @@index([toUserId])
  @@index([status])
  @@index([requestId])
  @@index([conversationId])
  @@index([licensePackageId])
}

// ============================================================
// Deal — Accepted offer after payment
// ============================================================

model Deal {
  id String @id @default(cuid())

  offerId String @unique
  offer   Offer  @relation(fields: [offerId], references: [id])

  payerId String
  payer   User   @relation("DealPayer", fields: [payerId], references: [id])
  payeeId String
  payee   User   @relation("DealPayee", fields: [payeeId], references: [id])

  authorizationId String?
  authorization  Authorization? @relation(fields: [authorizationId], references: [id])
  lawyerCaseId   String?
  lawyerCase     LawyerCase?   @relation(fields: [lawyerCaseId], references: [id])

  // Status: PENDING_PAYMENT | PAID | ACTIVE | COMPLETED | DISPUTED | CANCELLED
  status String @default("PENDING_PAYMENT")

  amount      Decimal @db.Decimal(12, 2)
  platformFee Decimal @db.Decimal(12, 2)
  netPayout   Decimal @db.Decimal(12, 2)
  currency    String  @default("USD")

  stripePaymentIntentId String? @unique
  paidAt     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payerId])
  @@index([payeeId])
  @@index([status])
  @@index([stripePaymentIntentId])
}

// ============================================================
// FeePolicy — Platform fee rates
// ============================================================

model FeePolicy {
  id String @id @default(cuid())

  transactionType String @unique
  platformFeeRate Decimal @db.Decimal(5, 4)
  minFee          Decimal? @db.Decimal(12, 2)
  currency        String @default("USD")
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// BalanceTransaction — User earnings ledger
// ============================================================

model BalanceTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Source: DEAL | LICENSE | LAWYER_CASE | MANUAL
  sourceType String
  sourceId   String?

  // Type: CREDIT | DEBIT | HOLD | RELEASE
  type   String
  amount Decimal @db.Decimal(12, 2)
  currency String @default("USD")

  // Status: PENDING | AVAILABLE | WITHDRAWN | CANCELLED
  status String @default("PENDING")

  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([status])
  @@index([sourceType, sourceId])
}

// ============================================================
// ConversationParticipant — Who is in a conversation
// ============================================================

model ConversationParticipant {
  id String @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Role in this conversation: ACTOR | CREATOR | LAWYER | ADMIN
  roleInConversation String @default("CREATOR")

  lastReadAt DateTime?
  createdAt  DateTime  @default(now())

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Sender
  senderId   String
  senderType String // "USER" | "LAWYER" | "ADMIN"
  senderRole String // "ACTOR" | "CREATOR" | "VERIFIER" | "ADMIN"

  // Conversation context (replaces caseId as primary for marketplace messaging)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // Legacy context (keep for lawyer notice compatibility)
  caseId     String?
  contractId String?

  // Content
  subject String?
  body    String  @db.Text
  isHtml  Boolean @default(false)

  // Attachments
  attachments Json?

  // Read status
  readAt DateTime?

  // Soft delete
  deletedAt String?
  deletedBy String?

  // Relations
  sender     User        @relation(fields: [senderId], references: [id])
  lawyerCase LawyerCase? @relation(fields: [caseId], references: [id])

  @@index([senderId])
  @@index([caseId])
  @@index([conversationId])
  @@index([contractId])
  @@index([createdAt])
}

// ============================================================
