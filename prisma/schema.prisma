  rateLimitPerMinute Int @default(60)

  lastUsedAt   DateTime?
  requestCount BigInt    @default(0)

  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([keyHash])
}

// ============================================================
// InfringementReportQuick — Quick intake for AI face theft victims
// No portrait/account required. Simplified flow for quick report generation.
// ============================================================

model InfringementReportQuick {
  id String @id @default(cuid())

  // Report number: PP-IR-YYYY-NNNN
  reportNumber String @unique
  status       String @default("GENERATED") // GENERATED | UPGRADED

  // The person filing the report (simplified registration)
  userId       String
  user         User   @relation(fields: [userId], references: [id])

  // Filing info
